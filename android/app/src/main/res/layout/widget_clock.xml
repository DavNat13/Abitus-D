<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget (11e): open the clock or start the stopwatch with one tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_clock"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:drawableTop="@drawable/ic_timer"
        android:drawableTint="#FFFFFF"
        android:gravity="center"
        android:text="@string/clock_title"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_stopwatch"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:drawableTop="@drawable/ic_flag"
        android:drawableTint="#FFFFFF"
        android:gravity="center"
        android:text="@string/clock_preset_stopwatch"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
</LinearLayout>
