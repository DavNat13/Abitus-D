# Copy to .env (local) or set in the Vercel project. Never commit real values.

# Runtime
NODE_ENV=
PORT=
LOG_LEVEL=

# Database (local: docker compose; production: Neon pooler URL with sslmode=require)
DATABASE_URL=

# Local docker compose PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Auth (Phase 1). Each secret: 32 or more random characters, all different
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=
CODE_PEPPER=
IP_HASH_PEPPER=

# Mail. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the account, SMTP_PASSWORD=app password. Local tests: Mailpit (127.0.0.1:1025)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_DAILY_CAP=

# Scheduled jobs (/internal/jobs/*)
JOBS_SECRET=
