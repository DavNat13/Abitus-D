{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CLAUDE.md",
    "claude/02-MEMORIA.md",
    "claude/02b-MEMORIA-DECISIONES-2.md",
    "claude/03-REGLAS-DE-ORO.md",
    "claude/12-DECISIONES-PENDIENTES.md"
  ],
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/AppData/Local/Android/Sdk/*", "effect": "allow" },
    { "action": "external_directory", "resource": "C:/Program Files/Java/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.gradle/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.android/*", "effect": "allow" },

    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.jks", "effect": "deny" },
    { "action": "read", "resource": "*.keystore", "effect": "deny" },

    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "ask" },
    { "action": "edit", "resource": "*AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "*CLAUDE.md", "effect": "deny" },
    { "action": "edit", "resource": "*opencode.json", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/*", "effect": "deny" },
    { "action": "edit", "resource": "*.claude/*", "effect": "deny" },
    { "action": "edit", "resource": "*.gitattributes", "effect": "deny" },
    { "action": "edit", "resource": "*.gitignore", "effect": "ask" },
    { "action": "edit", "resource": "*legal/*", "effect": "deny" },
    { "action": "edit", "resource": "*distribution/*", "effect": "deny" },
    { "action": "edit", "resource": "*distribution/THIRD_PARTY.md", "effect": "allow" },
    { "action": "edit", "resource": "*claude/03-REGLAS-DE-ORO.md", "effect": "deny" },
    { "action": "edit", "resource": "*claude/12-DECISIONES-PENDIENTES.md", "effect": "ask" },

    { "action": "shell", "resource": "npm install *", "effect": "ask" },
    { "action": "shell", "resource": "npm i *", "effect": "ask" },
    { "action": "shell", "resource": "npm uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "npm update *", "effect": "ask" },
    { "action": "shell", "resource": "npx *", "effect": "ask" },
    { "action": "shell", "resource": "npm publish*", "effect": "deny" },
    { "action": "shell", "resource": "npm * -g *", "effect": "deny" },
    { "action": "shell", "resource": "npm * --global*", "effect": "deny" },

    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push --delete*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --delete*", "effect": "deny" },
    { "action": "shell", "resource": "git push * :*", "effect": "deny" },
    { "action": "shell", "resource": "git push --mirror*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },
    { "action": "shell", "resource": "git commit --amend*", "effect": "deny" },
    { "action": "shell", "resource": "git commit * --amend*", "effect": "deny" },
    { "action": "shell", "resource": "git commit * --no-verify*", "effect": "deny" },
    { "action": "shell", "resource": "git tag -d *", "effect": "deny" },
    { "action": "shell", "resource": "git tag --delete *", "effect": "deny" },
    { "action": "shell", "resource": "git tag -f *", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-branch*", "effect": "deny" },
    { "action": "shell", "resource": "git config *", "effect": "deny" },
    { "action": "shell", "resource": "git remote *", "effect": "deny" },
    { "action": "shell", "resource": "git stash drop*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "gh *", "effect": "deny" },

    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -r *", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item * -Recurse*", "effect": "ask" },
    { "action": "shell", "resource": "rd /s*", "effect": "deny" },
    { "action": "shell", "resource": "rmdir /s*", "effect": "deny" },
    { "action": "shell", "resource": "del /s*", "effect": "deny" },
    { "action": "shell", "resource": "format *", "effect": "deny" },

    { "action": "shell", "resource": "cat *.env*", "effect": "deny" },
    { "action": "shell", "resource": "type *.env*", "effect": "deny" },
    { "action": "shell", "resource": "Get-Content *.env*", "effect": "deny" },
    { "action": "shell", "resource": "gc *.env*", "effect": "deny" },
    { "action": "shell", "resource": "more *.env*", "effect": "deny" },
    { "action": "shell", "resource": "head *.env*", "effect": "deny" },
    { "action": "shell", "resource": "tail *.env*", "effect": "deny" },
    { "action": "shell", "resource": "grep * *.env*", "effect": "deny" },
    { "action": "shell", "resource": "source *", "effect": "deny" },
    { "action": "shell", "resource": ". ./*", "effect": "deny" },
    { "action": "shell", "resource": "set -a*", "effect": "deny" },
    { "action": "shell", "resource": "printenv*", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "Get-ChildItem env:*", "effect": "deny" },
    { "action": "shell", "resource": "gci env:*", "effect": "deny" },

    { "action": "shell", "resource": "docker compose down -v*", "effect": "deny" },
    { "action": "shell", "resource": "docker compose down * -v*", "effect": "deny" },
    { "action": "shell", "resource": "docker volume rm *", "effect": "deny" },
    { "action": "shell", "resource": "docker volume prune*", "effect": "deny" },
    { "action": "shell", "resource": "docker system prune*", "effect": "deny" },
    { "action": "shell", "resource": "docker rm *", "effect": "ask" },
    { "action": "shell", "resource": "* DROP DATABASE*", "effect": "deny" },
    { "action": "shell", "resource": "* drop database*", "effect": "deny" },

    { "action": "shell", "resource": "sdkmanager --uninstall*", "effect": "deny" },
    { "action": "shell", "resource": "avdmanager delete *", "effect": "deny" },
    { "action": "shell", "resource": "setx *", "effect": "deny" },
    { "action": "shell", "resource": "reg *", "effect": "deny" },
    { "action": "shell", "resource": "winget *", "effect": "deny" },
    { "action": "shell", "resource": "choco *", "effect": "deny" },
    { "action": "shell", "resource": "shutdown *", "effect": "deny" },
    { "action": "shell", "resource": "curl * | *", "effect": "deny" },
    { "action": "shell", "resource": "iwr * | iex*", "effect": "deny" },
    { "action": "shell", "resource": "* | iex*", "effect": "deny" },
    { "action": "shell", "resource": "Invoke-Expression *", "effect": "deny" },
    { "action": "shell", "resource": "* vercel *", "effect": "deny" },
    { "action": "shell", "resource": "vercel *", "effect": "deny" },
    { "action": "shell", "resource": "neonctl *", "effect": "deny" }
  ]
}
